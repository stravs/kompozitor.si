{
  "name": "kompozitor-si",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/_astro/*", "!/izba-mark.svg", "!/kompozitor-mark.svg"]
  },
  // The Worker sends to the verified inbox configured in the IZBA_RECIPIENT secret.
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["anze@kompozitor.si"] }
  ]
}
