---
import '../styles/global.css';
import {variants,inbox} from '../data';
interface Props {title:string; paper?:boolean;}
const {title,paper}=Astro.props;
---
<!doctype html>
<html lang="sl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} — Kompozitor</title><meta name="description" content="Neodvisni studio za oblikovanje in razvoj spletnih strani. Izba za gostitelje: pošljite povezavo do nastanitve, za ostalo poskrbimo mi."/><meta name="robots" content="noindex,follow"/></head>
<body class:list={['font-sans text-neutral-900 antialiased selection:bg-neutral-900 selection:text-white',paper?'bg-[#f6f5f0]':'bg-white']}>
<a href="#vsebina" class="sr-only focus:not-sr-only">Preskoči na vsebino</a>
<slot/>
<footer class="mx-auto max-w-[1600px] px-5 py-8 md:px-12"><div class="flex flex-wrap items-baseline justify-between gap-5 border-t border-neutral-400 pt-5 text-xs"><a class="underline underline-offset-4" href={'mailto:'+inbox}>{inbox}</a><nav aria-label="Primerjava prototipov" class="flex flex-wrap items-center gap-x-4 gap-y-2"><span class="font-mono text-neutral-600">PROTOTIPI</span>{variants.map(([n,label,url])=><a href={url} aria-current={Astro.url.pathname===url?'page':undefined} class="hover:underline aria-[current=page]:underline underline-offset-4">{n} {label}</a>)}</nav></div></footer>
</body></html>
