<script>
  // Hero carousel: the active tab's progress bar times the slide (pauses on
  // hover/focus); clicking a tab stops autoplay. No autoplay for reduced motion.
  for (const carousel of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const slides = [...carousel.querySelectorAll<HTMLElement>('[data-slide]')];
    const tabs = [...carousel.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    let playing = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const show = (n: number) => {
      slides.forEach((slide, i) => {
        slide.toggleAttribute('data-active', i === n);
        slide.inert = i !== n;
      });
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-pressed', String(i === n));
        tab.querySelector('[data-fill]')?.classList.toggle('animate-progress', playing && i === n);
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => { playing = false; show(i); });
      tab.querySelector('[data-fill]')?.addEventListener('animationend', () => show((i + 1) % slides.length));
    });
    show(0);
  }

  import { euro, phone, setupPrice, pricing } from '../../izba';
  import { inbox } from '../../data';

  const calc = document.querySelector<HTMLElement>('[data-calc]');
  if (calc) {
    const out = (name: string) => calc.querySelector<HTMLElement>(`[data-out="${name}"]`)!;
    calc.addEventListener('change', (event) => {
      const units = Number((event.target as HTMLInputElement).value);
      const setup = setupPrice(units);
      calc.querySelector<HTMLElement>('[data-quote]')!.hidden = setup !== null;
      for (const el of calc.querySelectorAll<HTMLElement>('[data-priced]')) el.hidden = setup === null;
      if (setup === null) {
        out('setup').textContent = 'Po dogovoru';
        out('formula').textContent = '';
        return;
      }
      out('setup').textContent = euro(setup);
      out('formula').textContent = units === 1 ? `ena enota · vsaka naslednja +${euro(pricing.perUnit)}` : `${euro(pricing.base)} + ${units - 1} × ${euro(pricing.perUnit)}`;
      const select = document.querySelector<HTMLSelectElement>('#enote');
      if (select) select.value = String(units);
    });
  }

  const form = document.querySelector<HTMLFormElement>('[data-izba-form]');
  if (form) {
    const links = form.querySelector<HTMLElement>('[data-links]')!;
    const addLink = form.querySelector<HTMLButtonElement>('[data-add-link]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
    const maxLinks = 5;
    const reservation = form.querySelector<HTMLSelectElement>('#rezervacije')!;
    const otherField = form.querySelector<HTMLElement>('[data-reservation-other]')!;
    const otherInput = otherField.querySelector('input')!;
    const syncReservation = () => {
      const isOther = reservation.value === 'Drugo';
      otherField.hidden = !isOther;
      otherInput.disabled = !isOther;
      otherInput.required = isOther;
    };
    reservation.addEventListener('change', syncReservation);
    syncReservation();

    addLink.hidden = false;
    addLink.addEventListener('click', () => {
      const first = links.querySelector('input')!;
      const input = first.cloneNode() as HTMLInputElement;
      input.id = `povezava-${links.children.length + 1}`;
      input.value = '';
      input.setAttribute('aria-label', `Povezava ${links.children.length + 1}`);
      links.append(input);
      input.focus();
      addLink.hidden = links.children.length >= maxLinks;
    });

    const showErrors = (errors: Record<string, string>) => {
      for (const el of form.querySelectorAll<HTMLElement>('[data-error]')) {
        const message = errors[el.dataset.error!] ?? '';
        el.textContent = message;
        const field = el.dataset.error === 'povezava' ? links.querySelector('input') : form.querySelector(`#${el.dataset.error}`);
        if (message) field?.setAttribute('aria-invalid', 'true');
        else field?.removeAttribute('aria-invalid');
      }
      const first = Object.keys(errors)[0];
      if (first) (first === 'povezava' ? links.querySelector('input') : form.querySelector<HTMLElement>(`#${first}`))?.focus();
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = '';
      submit.disabled = true;
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const result = await response.json().catch(() => ({}));
        if (response.ok && result.ok) {
          const sent = document.querySelector<HTMLElement>('[data-izba-sent]')!;
          sent.querySelector('[data-sent-email]')!.textContent = String(new FormData(form).get('email'));
          form.hidden = true;
          sent.hidden = false;
          sent.focus();
          return;
        }
        if (response.status === 400 && result.errors) showErrors(result.errors);
        else throw new Error(`HTTP ${response.status}`);
      } catch {
        status.textContent = `Pošiljanje ni uspelo. Pišite na ${inbox} ali pokličite ${phone}.`;
      } finally {
        submit.disabled = false;
      }
    });
  }

  // Desktop and phone previews scroll together, matched by progress (the
  // screenshots have different heights). Only the preview the visitor last
  // touched leads; the other just follows. Nothing is ever written back to the
  // leader, so its native smooth/momentum scrolling is never interrupted.
  for (const project of document.querySelectorAll('#primer article')) {
    const panes = [...project.querySelectorAll<HTMLElement>('[role="region"]')];
    if (panes.length !== 2) continue;
    let leader = panes[0];
    const follow = () => {
      const follower = panes[+(leader === panes[0])];
      const range = leader.scrollHeight - leader.clientHeight;
      const progress = range > 0 ? Math.min(1, Math.max(0, leader.scrollTop / range)) : 0;
      follower.scrollTop = progress * (follower.scrollHeight - follower.clientHeight);
    };
    // Phones send scroll events unevenly during a swipe and its momentum, so
    // once scrolling starts, follow every frame until the leader settles.
    let tracking = false;
    const track = () => {
      if (tracking) return;
      tracking = true;
      let last = NaN;
      let still = 0;
      const frame = () => {
        follow();
        still = leader.scrollTop === last ? still + 1 : 0;
        last = leader.scrollTop;
        if (still < 10) requestAnimationFrame(frame);
        else tracking = false;
      };
      requestAnimationFrame(frame);
    };
    for (const pane of panes) {
      for (const type of ['wheel', 'touchstart', 'pointerdown', 'keydown'] as const) {
        pane.addEventListener(type, () => { leader = pane; }, { passive: true });
      }
      pane.addEventListener('scroll', () => { if (pane === leader) track(); }, { passive: true });
    }
    // Keep them aligned when the layout changes size (rotation, resize, image load).
    const resized = new ResizeObserver(follow);
    for (const pane of panes) resized.observe(pane);
    for (const img of project.querySelectorAll('img')) img.addEventListener('load', follow);
  }

  // Projects switch with CSS radios. Links to #project-id (e.g. from the hero)
  // tick that project's radio first, so its article is visible to scroll to.
  const pickProject = (id: string) => {
    const radio = id ? document.querySelector<HTMLInputElement>(`#projekt-${CSS.escape(id)}`) : null;
    if (radio) radio.checked = true;
    return !!radio;
  };
  document.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
    if (link) pickProject(link.hash.slice(1));
  });
  if (pickProject(location.hash.slice(1))) document.getElementById(location.hash.slice(1))?.scrollIntoView();
</script>
