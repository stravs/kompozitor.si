---
import { Image } from 'astro:assets';
import Izba from '../../layouts/Izba.astro';
import nook from '../../assets/projects/nook-full-desktop.webp';
import nookMobile from '../../assets/projects/nook-full-mobile.webp';
import olga from '../../assets/projects/olga-full-desktop.webp';
import olgaMobile from '../../assets/projects/olga-full-mobile.webp';
import ingreen from '../../assets/projects/ingreen-full-desktop.webp';
import ingreenUnitMobile from '../../assets/projects/ingreen-full-mobile.webp';
import ingreenDesktop from '../../assets/projects/ingreen-feature-desktop.webp';
import ingreenMobile from '../../assets/projects/ingreen-feature-mobile.webp';
import roseDesktop from '../../assets/projects/rose-in-winter-full-desktop.webp';
import roseMobile from '../../assets/projects/rose-in-winter-full-mobile.webp';
import reviewsShot from '../../assets/included/reviews.webp';
import photosShot from '../../assets/included/photos.webp';
import siteDesktop from '../../assets/included/site-desktop.webp';
import siteMobile from '../../assets/included/site-mobile.webp';
import { inbox } from '../../data';
import { getArticles } from '../../lib/clanki';
import { euro, origin, owner, phone, pricing, shell, tel, whatsapp } from '../../izba';

const display = 'text-[clamp(2.45rem,5.1vw,5rem)] font-semibold leading-[.99] tracking-[-.05em] [word-spacing:.025em]';
const label = 'text-sm font-semibold tracking-[-.015em]';
// Lime (--accent) only sits on a dark background (except in the #stik panel).
const buttonBase = 'inline-flex min-h-14 w-fit items-center justify-center rounded-full px-6 py-2 text-sm font-semibold motion-safe:transition-colors';
const button = `${buttonBase} bg-(--deep) text-(--accent) hover:bg-(--ink)`;
const buttonOnDark = `${buttonBase} bg-(--accent) text-(--ink) hover:bg-(--accent-hover)`;
const title = 'Izba — Spletne strani za apartmaje in manjše nastanitve';
const description = 'Iz vašega Booking.com/Airbnb oglasa do spletne strani po meri. Izba uredi vsebino in izdela lastno stran za apartma ali manjšo nastanitev. Storitev studia Kompozitor.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Izba',
  serviceType: 'Izdelava spletnih strani za apartmaje in manjše nastanitve',
  url: `${origin}/`,
  areaServed: { '@type': 'Country', name: 'Slovenija' },
  provider: { '@type': 'Organization', name: 'Kompozitor', url: 'https://kompozitor.si/', email: inbox, telephone: tel.slice(4) },
};
const nookUrl = 'https://nature-nook.si/';
const ingreenUrl = 'https://ingreen-house.si/';
const olgaUrl = 'https://apartments-olga.si/';
// Hero carousel. Inactive slides wait lower down; the active one rises into place.
const enter = 'opacity-0 transition duration-700 ease-[cubic-bezier(.2,.8,.2,1)] group-data-active:translate-y-0 group-data-active:scale-100 group-data-active:rotate-0 group-data-active:opacity-100 motion-reduce:transition-none';
const featured = [
  { name: 'InGreen', id: 'ingreen', place: 'Obrne, Slovenija', desktop: ingreenDesktop, mobile: ingreenMobile, alt: 'Naslovna stran InGreen s fotografijo hiše in vrta ter dostopom do apartmajev' },
  { name: 'Nature Nook', id: 'nature-nook', place: 'Bled, Slovenija', desktop: nook, mobile: nookMobile, alt: 'Naslovna stran Nature Nook z veliko fotografijo terase med krošnjami' },
  { name: 'Apartments Olga', id: 'apartments-olga', place: 'Bled, Slovenija', desktop: olga, mobile: olgaMobile, alt: 'Naslovna stran Apartments Olga s kolažem fotografij apartmajev' },
];
const projects = [
  {
    name: 'Nature Nook', id: 'nature-nook', note: 'Bled · En apartma', href: nookUrl, image: nook, mobile: nookMobile,
    alt: 'Angleška naslovna stran Nature Nook z veliko fotografijo terase med krošnjami',
  },
  {
    name: 'Apartments Olga', id: 'apartments-olga', note: 'Bled · Štirje apartmaji', href: olgaUrl, image: olga, mobile: olgaMobile,
    alt: 'Angleška naslovna stran Apartments Olga s kolažem fotografij in pregledom apartmajev na obeh lokacijah',
  },
  {
    name: 'InGreen', id: 'ingreen', note: 'Obrne · Štirje apartmaji', href: ingreenUrl, image: ingreen, mobile: ingreenUnitMobile,
    alt: 'Angleška naslovna stran InGreen s fotografijo hiše in vrta ter pregledom štirih enot',
  },
  {
    name: 'Rose in Winter', id: 'rose-in-winter', note: 'Bled · Pet apartmajev', href: 'https://roseinwinter.com/', image: roseDesktop, mobile: roseMobile,
    alt: 'Angleška naslovna stran Rose in Winter z ilustracijo hiše in vrta ter pregledom apartmajev',
  },
];
const process = [
  ['Vi', 'Pošljete povezavo', 'Pošljete nam povezavo do oglasa na Bookingu ali Airbnbju. Za začetek ne potrebujemo ničesar drugega.'],
  ['Izba', 'Pripravimo predogled', 'Pregledamo oglas, fotografije in mnenja gostov. V 3 delovnih dneh vam pošljemo brezplačen predogled brez obveznosti.'],
  ['Vi', 'Pregledate in potrdite', 'Če želite spremembe, jih zberete v enem sporočilu. Popravke uredimo mi. Ko vam stran ustreza, jo potrdite in plačate.'],
  ['Izba', 'Objavimo stran', 'Po potrditvi in plačilu vašo spletno stran objavimo v 3 delovnih dneh.'],
] as const;
const included = [
  { id: 'nasveti', title: 'Nasveti za vaš oglas', body: 'Preberemo vaš oglas in mnenja gostov, opozorimo na morebitna neskladja v opisu ter vam povemo, kako lahko nastanitev predstavite še bolje. Po želji izbrane pohvale postavimo na stran.', image: reviewsShot, alt: 'Del strani Apartments Olga z oceno 9,1 na Bookingu in tremi mnenji gostov' },
  { id: 'fotografije', title: 'Besedila in fotografije', body: 'Uredimo opise ter izberemo in razvrstimo fotografije. Po potrebi jih malo posvetlimo ali poravnamo. Novega fotografiranja ni.', image: photosShot, alt: 'Del strani InGreen: fotografije vrta in bazena, urejene v galerijo s kratkimi opisi' },
  { id: 'stran', title: 'Vaša spletna stran', body: 'Oblikovana posebej za vas, v slovenščini, angleščini, nemščini in italijanščini. Lepo deluje tudi na telefonu. Ima fotografije, predstavitev, zemljevid in obrazec, prek katerega vam gostje pišejo.' },
  { id: 'iskalniki', title: 'Da vas najdejo', body: 'Stran pripravimo tako, da jo hitro najdejo iskalniki (Google, Bing) in AI pomočniki (ChatGPT, Gemini).' },
];
const maintenance = [
  ['Manjše spremembe', 'Zamenjamo fotografijo, popravimo besedilo, posodobimo ceno ali uredimo drugo malenkost. V razumnem obsegu brez doplačila.'],
  ['Stran je vedno dosegljiva', 'Poskrbimo, da stran deluje in je dosegljiva na vašem naslovu.'],
  ['Varna povezava', 'Ob naslovu strani se prikaže ključavnica, brskalnik pa gostov ne opozarja, da stran ni varna.'],
  ['Pomoč, ko kaj ne dela', 'Če kaj ne deluje, nam pišite in uredimo. Večje posege prej dogovorimo.'],
  ['Koliko ljudi obišče stran', 'Obiske štejemo brez piškotkov, zato gostov ne moti pasica za soglasje. Številke vam pošljemo, kadar jih želite.'],
  ['E-naslov z imenom vaše strani', 'Npr. info@vasa-nastanitev.si. Sporočila prihajajo v vaš obstoječi e-predal. Brez doplačila.'],
];
const questions = [
  ['Zakaj lastna spletna stran?', 'Z lastno stranjo niste odvisni le od Bookinga. Če Booking ali Airbnb spremeni pravila ali provizije ali vaš oglas skrije, lahko ostanete brez gostov. Lastna stran je vaša. Gostje vam prek nje pišejo neposredno, brez provizije. Vse več ljudi nastanitve išče tudi z orodji umetne inteligence, ki dostikrat predlagajo povezave do uradnih strani nastanitev.', 'konec-prevlade-rezervacijskih-platform'],
  ['Koliko stane predogled?', 'Predogled je brezplačen. Pripravimo ga v 3 delovnih dneh. Če vam ni všeč, ne plačate ničesar.'],
  ['Kaj se zgodi z oglasom na Bookingu ali Airbnbju?', 'Nič. Oglas ostane, kot je. Spletna stran je dodaten kraj, kjer vas gostje spoznajo in vam pišejo neposredno.'],
  ['Ali je sporočilo prek obrazca že rezervacija?', 'Ne. Sporočilo gosta pride na vaš e-naslov, termin in ceno pa se z njim dogovorite sami. Stran nima koledarja zasedenosti in ne sprejema plačil.'],
  ['V katerih jezikih je stran?', 'V slovenščini, angleščini, nemščini in italijanščini, brez doplačila. Slovensko in angleško različico pregledamo sami. Nemščine in italijanščine ne govorimo, zato vam ti različici pred objavo pošljemo v pregled.'],
  ['V čem se Izba razlikuje od orodij, kot je Wix?', 'Pri Wixu in podobnih orodjih stran izdelate sami. Pri Izbi zadošča povezava do oglasa, za vse ostalo poskrbimo mi.'],
  ['Je stran mogoče povezati z rezervacijskim sistemom?', 'Preverimo, kako lahko obstoječi rezervacijski sistem (npr. Bentral ali SnapGuest) povežemo s spletno stranjo. Če je povezava mogoča, jo za zdaj uredimo brez doplačila.'],
  ['Kaj je potrebno za začetek?', 'Le povezava do oglasa na Bookingu ali Airbnbju. Gesla, nova besedila in fotografije niso potrebni.'],
  ['Kdo je lastnik domene?', 'Naslov strani (domeno) registriramo na vaše ime in ga zaračunamo toliko, kolikor stane nas. Če se kdaj odločite končati sodelovanje, stran ugasne, vi pa obdržite naslov in dobite vse datoteke strani. Pri selitvi vam pomagamo.'],
  ['Koliko stane domena?', 'Domena .si stane približno 15 do 20 € na leto z DDV, domena .com podobno. Zaračunamo jo toliko, kolikor stane nas, in vam ceno povemo pred registracijo.'],
];
// FAQ answers can point to an article (third item: its slug) once it is published.
const articleTitles = new Map((await getArticles()).map(({ id, data }) => [id, data.title]));
---
<Izba {title} {description} path="/" {schema}>
    <main id="vsebina" tabindex="-1">
      <section class={`${shell} grid gap-7 pt-8 pb-11 sm:gap-12 sm:py-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.04fr)] lg:items-center lg:gap-9 lg:py-[clamp(3.25rem,5vw,5.5rem)] xl:gap-12`}>
        <div>
          <p class="flex items-baseline gap-2.5 text-sm font-medium text-(--muted)"><span class="size-2 shrink-0 rounded-full bg-(--tone)" aria-hidden="true"></span>Spletne strani za apartmaje in manjše nastanitve</p>
          <h1 class="mt-4 max-w-[15ch] text-[clamp(2.35rem,11vw,3.55rem)] leading-[.96] font-semibold tracking-[-.052em] text-balance [word-spacing:.025em] sm:mt-6 sm:text-[clamp(3.35rem,6.5vw,4.5rem)] lg:text-[clamp(3.35rem,5.72vw,6rem)]">Iz vašega <span class="sr-only text-(--deep) motion-reduce:not-sr-only">Booking.com/<wbr />Airbnb</span><span class="inline-grid text-(--deep) motion-reduce:hidden"><span aria-hidden="true" class="col-start-1 row-start-1 animate-roll will-change-transform">Booking.com</span><span aria-hidden="true" class="col-start-1 row-start-1 animate-roll opacity-0 will-change-transform [animation-delay:-3s]">Airbnb</span></span> oglasa do spletne strani <span class="block"><span class="relative isolate -mx-[.1em] inline-block before:absolute before:inset-0 before:-z-10 before:origin-left before:animate-highlight before:rounded-[.12em] before:bg-(--deep) motion-reduce:before:animate-none"><span class="-my-[.1em] inline-block bg-[linear-gradient(to_right,var(--accent)_50%,var(--ink)_50%)] bg-size-[200%_100%] bg-left bg-clip-text px-[.1em] py-[.1em] text-transparent animate-highlight-text motion-reduce:animate-none">po meri.</span></span></span></h1>
          <p class="mt-5 max-w-[45ch] text-base leading-[1.6] text-(--muted) sm:mt-6 sm:text-lg">Pošljete nam povezavo do oglasa, mi pa pripravimo spletno stran za vašo nastanitev v štirih jezikih. Oglas obdržite, gostje pa vam lahko pišejo tudi neposredno.</p>
          <div class="mt-5 flex flex-wrap items-center gap-3 sm:mt-8">
            <a href="#stik" class={button}>Pošljite povezavo do oglasa</a>
            <a href="#primer" class={`${buttonBase} border border-(--line) hover:border-(--ink) hover:bg-(--field)`}>Poglejte primere</a>
          </div>
          <p class="mt-1 text-sm leading-relaxed text-(--muted) sm:mt-4">Dovolj je povezava. Brez gesel, novih fotografij ali besedil.</p>
        </div>

        <figure data-carousel aria-roledescription="carousel" aria-label="Izbrane spletne strani" class="group/carousel min-w-0">
          <div class="relative isolate aspect-[1.13] overflow-hidden rounded-[1.4rem] bg-(--stage) sm:aspect-[1.2] sm:rounded-[2rem]">
            <svg class="pointer-events-none absolute -top-8 -right-8 -z-10 h-[70%] w-auto max-w-[75%] rotate-180 text-(--tone)/30" viewBox="0 0 560 360" fill="none" aria-hidden="true">
              <path d="M142 360V127L508 23v337M109 360V152L475 48v312M76 360V177L442 73v287M43 360V202L409 98v262" stroke="currentColor" stroke-width="1.5" />
            </svg>
            {featured.map(({ name, id, place, desktop, mobile, alt }, i) => (
              <a href={`#${id}`} data-slide data-active={i === 0 ? '' : undefined} inert={i !== 0} aria-label={`Projekt ${name}`} class="group absolute inset-0 opacity-0 transition-opacity duration-500 data-active:opacity-100 motion-reduce:transition-none">
                <div class={`absolute top-[14%] left-[6%] w-[81%] ${enter} translate-y-8 scale-[.96]`}>
                  <Image src={desktop} {alt} width={1100} height={688} fit="cover" position="top" widths={[320, 480, 720, 960, 1100]} sizes="(min-width: 1536px) 560px, (min-width: 1024px) 39vw, 76vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'low'} class="block w-full rounded-[.55rem] border border-white/55 shadow-[0_20px_40px_#101a1333] motion-safe:transition-transform motion-safe:duration-700 motion-safe:ease-[cubic-bezier(.22,1,.36,1)] motion-safe:will-change-transform motion-safe:group-hover:-translate-y-1.5 sm:rounded-xl" />
                </div>
                <div class={`absolute right-[6%] bottom-[8%] w-[23%] ${enter} translate-y-16 rotate-6 group-data-active:delay-150`}>
                  <Image src={mobile} alt="" width={390} height={740} fit="cover" position="top" widths={[120, 180, 240, 390]} sizes="(min-width: 1536px) 168px, (min-width: 1024px) 12vw, 22vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority="low" class="block w-full rounded-[.5rem] border-[3px] border-(--ink) shadow-[0_12px_25px_#101a1340] motion-safe:transition-transform motion-safe:delay-75 motion-safe:duration-700 motion-safe:ease-[cubic-bezier(.22,1,.36,1)] motion-safe:will-change-transform motion-safe:group-hover:-translate-y-2.5 sm:rounded-[1rem] sm:border-4" />
                </div>
                <span class={`absolute bottom-3 left-4 flex items-center gap-2 text-xs whitespace-nowrap text-(--ink) sm:bottom-4 sm:left-6 lg:left-1/2 lg:-translate-x-1/2 ${enter} group-data-active:delay-300`}><span class="size-1.5 rounded-full bg-(--deep)" aria-hidden="true"></span>{place}</span>
              </a>
            ))}
          </div>
          <div class="mt-3 grid grid-cols-3 gap-2 sm:mt-4 sm:gap-4">
            {featured.map(({ name }, i) => (
              <button type="button" data-tab aria-pressed={i === 0 ? 'true' : 'false'} class="group min-h-11 cursor-pointer text-left text-xs font-medium text-(--muted) hover:text-(--ink) aria-pressed:text-(--ink) focus-visible:outline-2 focus-visible:outline-offset-4 sm:text-sm">
                <span class="block h-0.5 overflow-hidden rounded-full bg-(--line)"><span data-fill class="block h-full origin-left scale-x-0 bg-(--ink) group-aria-pressed:scale-x-100 group-hover/carousel:[animation-play-state:paused] group-focus-within/carousel:[animation-play-state:paused]"></span></span>
                <span class="mt-2 block truncate">{name}</span>
              </button>
            ))}
          </div>
        </figure>
      </section>

      <section id="primer" class={`${shell} scroll-mt-6 pb-16 sm:pb-24`}>
        <div class="flex flex-col gap-5 border-t border-(--line) pt-8 sm:pt-12 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
          <div>
            <p class={label}>Naše delo</p>
            <h2 class={`${display} mt-4`}>Primeri strani</h2>
          </div>
        </div>
        {/* Pure-CSS picker: each radio shows the article two siblings after it. */}
        <div style={`--project-count:${projects.length}`} class="mt-8 grid grid-cols-2 gap-x-2 gap-y-2 sm:mt-12 sm:grid-cols-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,3fr)] lg:grid-rows-[repeat(var(--project-count),auto)_1fr] lg:gap-x-8 lg:gap-y-0">
          {projects.map(({ name, id, note, href, image, mobile, alt }, i) => (
            <Fragment>
              <input type="radio" name="projekt" id={`projekt-${id}`} value={id} checked={i === 0} class="sr-only" />
              <label for={`projekt-${id}`} class="relative flex min-h-12 min-w-0 cursor-pointer flex-col justify-center gap-1 border-b border-(--line) px-2 py-3 text-center text-(--muted) hover:bg-(--field)/55 hover:text-(--ink) motion-safe:transition-colors after:pointer-events-none after:absolute after:inset-x-0 after:-bottom-px after:h-0.5 after:bg-(--tone) after:opacity-0 sm:px-4 lg:col-start-1 lg:py-4 lg:pr-10 lg:text-left lg:first-of-type:border-t lg:after:inset-y-0 lg:after:right-auto lg:after:h-auto lg:after:w-0.5 [input:checked+&]:bg-(--field) [input:checked+&]:text-(--ink) [input:checked+&]:after:opacity-100 [input:focus-visible+&]:z-10 [input:focus-visible+&]:outline-2 [input:focus-visible+&]:-outline-offset-2">
                <span class="text-sm leading-tight font-semibold tracking-tight [overflow-wrap:anywhere] sm:text-base lg:text-xl">{name}</span>
                <span class="hidden text-xs text-(--muted) sm:block lg:text-sm">{note}</span>
                <svg aria-hidden="true" class="absolute top-1/2 right-4 hidden size-4 -translate-y-1/2 text-(--tone) opacity-0 lg:block [input:checked+label_&]:opacity-100" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 4 4 4-4 4" /></svg>
              </label>
              <article id={id} aria-label={name} class="order-last col-span-full hidden min-w-0 scroll-mt-6 pt-2 lg:col-span-1 lg:col-start-2 lg:row-span-full lg:pt-0 [input:checked+label+&]:block">
                {/* From sm up, the desktop sets the row height and the phone stretches to match. On phones they stack. */}
                <div class="grid items-stretch gap-4 rounded-[1.25rem] bg-(--field) p-3 ring-1 ring-(--ink)/12 sm:grid-cols-[minmax(0,1fr)_26%] sm:gap-5 sm:rounded-[1.6rem] sm:p-6 lg:p-8">
                  <div class="overflow-hidden rounded-lg border border-(--ink)/15 bg-(--paper) shadow-[0_20px_40px_#101a1322] sm:rounded-xl">
                    <div class="flex min-h-7 items-center gap-2 border-b border-(--line) px-2.5 sm:min-h-10 sm:px-4" aria-hidden="true">
                      <span class="hidden gap-1.5 sm:flex"><span class="size-2.5 rounded-full bg-(--ink)/15"></span><span class="size-2.5 rounded-full bg-(--ink)/15"></span><span class="size-2.5 rounded-full bg-(--ink)/15"></span></span>
                      <span class="min-w-0 flex-1 truncate rounded-full bg-(--field) px-3 py-0.5 text-center text-[.65rem] text-(--muted) sm:py-1 sm:text-xs">{new URL(href).hostname}</span>
                    </div>
                    <div role="region" tabindex="0" aria-label={`Računalniški predogled: ${name}`} class="aspect-[16/10] overflow-x-hidden overflow-y-auto overscroll-contain pointer-coarse:overscroll-auto [scrollbar-width:thin] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-(--tone)">
                      <Image src={image} {alt} widths={[480, 720, 960, 1280]} sizes="(min-width: 1536px) 820px, (min-width: 1024px) 52vw, (min-width: 640px) 68vw, (min-resolution: 2.5dppx) 240px, 86vw" loading="lazy" class="block h-auto w-full" />
                    </div>
                  </div>
                  <div class="flex aspect-[9/17] w-[58%] flex-col justify-self-center overflow-hidden rounded-[1.2rem] border-4 border-(--ink) bg-(--ink) shadow-[0_12px_25px_#101a1340] sm:aspect-auto sm:w-auto sm:justify-self-stretch sm:rounded-[1.4rem] sm:border-[5px] sm:[contain:size]">
                    <div class="flex h-5 shrink-0 items-center justify-center" aria-hidden="true"><span class="h-1.5 w-1/3 rounded-full bg-white/25"></span></div>
                    <div role="region" tabindex="0" aria-label={`Mobilni predogled: ${name}`} class="min-h-0 flex-1 overflow-x-hidden overflow-y-auto overscroll-contain pointer-coarse:overscroll-auto bg-(--paper) [scrollbar-width:thin] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-(--tone)">
                      <Image src={mobile} alt="" widths={[120, 240, 390]} sizes="(min-width: 1536px) 290px, (min-width: 1024px) 18vw, (min-width: 640px) 24vw, 50vw" loading="lazy" class="block h-auto w-full" />
                    </div>
                  </div>
                </div>
                <div class="mt-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
                  <p class="text-sm text-(--muted)">Pomaknite se po predogledu in si oglejte celotno stran.</p>
                  <a href={href} hreflang="en" class="inline-flex min-h-11 items-center border-b border-(--line) text-sm font-semibold hover:border-current motion-safe:transition-colors">
                    Odprite {new URL(href).hostname}
                  </a>
                </div>
              </article>
            </Fragment>
          ))}
        </div>
      </section>

      <section id="postopek" class={`${shell} scroll-mt-6`}>
        <div class="rounded-[1.5rem] bg-(--field) px-5 py-8 sm:rounded-[2rem] sm:p-10 lg:p-12">
          <p class={label}>Kako sodelujemo</p>
          <h2 class={`${display} mt-4`}>Od oglasa do objave.</h2>
          <ol role="list" data-steps class="mt-7 grid gap-3 sm:mt-9 sm:grid-cols-2 sm:gap-4 xl:grid-cols-4">
            {process.map(([who, title, body], i) => (
              <li class="rounded-2xl border border-(--line) bg-(--paper) p-5">
                <div class="flex items-center justify-between gap-3">
                  <strong class={`rounded-full border px-3 py-1 text-sm font-semibold ${who === 'Vi' ? 'border-(--line) text-(--ink)' : 'border-transparent bg-(--deep) text-(--accent)'}`}>{who}</strong>
