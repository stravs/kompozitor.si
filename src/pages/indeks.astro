---
import Base from '../layouts/Base.astro';import Header from '../components/Header.astro';import Shot from '../components/Shot.astro';
import {redesigns,stays,izbaCopy,listing} from '../data';
const entries=[...redesigns.map(([name,url,kind])=>({name,url,kind})),...stays.map(([name,url])=>({name,url,kind:'Izba / nastanitev'}))];
---
<Base title="Indeks" paper><div class="mx-auto max-w-6xl px-5 md:px-10"><Header/><main id="vsebina">
<section class="grid gap-4 py-10 md:grid-cols-[1fr_2fr] md:py-14"><p class="font-mono text-xs uppercase tracking-widest">Kompozitor / Studio</p><div><h1 class="text-3xl leading-tight tracking-tight md:text-5xl">Spletno oblikovanje in razvoj.</h1><p class="mt-3 max-w-xl text-lg">Majhen studio, neposreden stik. Projekte vodim sam, po potrebi pa sestavim ekipo.</p></div></section>
<section id="delo"><div class="flex justify-between border-y border-neutral-800 py-2 font-mono text-xs uppercase tracking-widest"><h2>Kazalo projektov</h2><span>01—07</span></div>
<ol>{entries.map(({name,url,kind},i)=><li class="border-b border-neutral-300"><a href={url} class="group grid grid-cols-[2rem_1fr_auto] items-center gap-x-2 py-3 sm:grid-cols-[3rem_1fr_10rem_auto]"><span class="row-span-2 font-mono text-xs sm:row-span-1">0{i+1}</span><span class="text-2xl tracking-tight group-hover:underline md:text-4xl">{name}</span><span class="col-start-2 row-start-2 text-xs sm:col-auto sm:row-auto">{kind}</span><span class="col-start-3 row-start-1 sm:col-auto">↗</span></a></li>)}</ol></section>
<section id="izba" class="my-12 grid gap-8 md:grid-cols-[1fr_2fr]"><Shot name="miska" alt="Naslovna stran Studia Miška" sizes="(min-width:768px) 32vw, 92vw"/><div><h2 class="text-3xl tracking-tight">Izba / Spletna stran iz oglasa</h2><p class="mt-3 max-w-xl text-lg">{izbaCopy}</p><a class="mt-4 inline-block underline underline-offset-4" href={listing}>Pošljite povezavo ↗</a></div></section></main></div></Base>