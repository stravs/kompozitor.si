---
import Base from '../layouts/Base.astro';import Logo from '../components/Logo.astro';import Shot from '../components/Shot.astro';import Stays from '../components/Stays.astro';import {redesigns,izbaCopy,inbox,listing} from '../data';
---
<Base title="Studio"><main id="vsebina" class="mx-auto grid max-w-[1600px] md:grid-cols-[.85fr_1.15fr]">
<aside class="flex flex-col items-start justify-between gap-10 border-b border-neutral-300 bg-[#f4f4f1] p-6 md:sticky md:top-0 md:h-screen md:border-r md:border-b-0 md:p-10"><Logo/><div><p class="mb-4 font-mono text-xs uppercase tracking-widest">Oblikovanje + razvoj</p><h1 class="max-w-md text-5xl leading-none tracking-[-.06em] lg:text-7xl">Vaš projekt.<br/>Moj studio.</h1><p class="mt-6 max-w-sm text-lg">Oblikujem in izdelujem spletne strani. Sodelujete neposredno z mano, pri večjih projektih tudi z mojo ekipo.</p></div><nav aria-label="Glavna navigacija" class="flex flex-wrap gap-5 text-sm underline underline-offset-4"><a href="#delo">Prenove ↓</a><a href="#izba">Izba ↓</a><a href={'mailto:'+inbox}>Pišite mi ↗</a></nav></aside>
<div class="min-w-0 px-5 py-7 md:px-10 md:py-10"><section id="izba"><p class="font-mono text-xs uppercase tracking-widest">Izba / Za gostitelje</p><h2 class="my-5 max-w-lg text-4xl leading-none tracking-tighter lg:text-6xl">Od povezave do lastne spletne strani.</h2><p class="max-w-xl">{izbaCopy}</p><a class="my-5 inline-block underline underline-offset-4" href={listing}>Pošljite povezavo ↗</a><a href="https://studio-miska.stravs-a.workers.dev/"><Shot name="miska" eager alt="Studio Miška, primer strani Izba"/></a><Stays/></section>
<section id="delo" class="mt-14"><h2 class="mb-5 border-t border-neutral-800 pt-3 font-mono text-xs uppercase tracking-widest">Izbrane prenove</h2>{redesigns.map(([name,url,kind],i)=><a href={url} class="group mb-8 block"><Shot name={i===0?'arbor':'bton'} alt={'Prenova spletne strani: '+name}/><div class="mt-2 flex items-baseline justify-between"><h3 class="text-2xl tracking-tight group-hover:underline">{name} ↗</h3><span class="text-xs">{kind}</span></div></a>)}</section></div></main></Base>